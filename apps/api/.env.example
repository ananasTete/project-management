# 本地开发不设 DATABASE_URL 时自动使用 PGLite（packages/db/.data/pg）
# DATABASE_URL=postgres://user:pass@localhost:5432/stack
PORT=3000
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# 前端 origin 白名单（逗号分隔，支持通配符，如 https://*.example.com）；
# 不设时默认放行本机任意端口的 vite dev（localhost/127.0.0.1/[::1]）。
# 生产必须设为真实前端 origin，如 TRUSTED_ORIGINS=https://app.example.com
# TRUSTED_ORIGINS=
